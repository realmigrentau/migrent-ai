# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright output
/test-results/
/playwright-report/
/blob-report/
/.env.production.local

# ABS + OpenStreetMap source downloads for the suburb directory ETL.
# ~430MB of Census archives, allocation files and boundary shapefiles, plus
# the unpacked shapefile and the Overpass extract. Re-fetch with
# scripts/abs/fetch-sources.mjs and scripts/abs/fetch-osm.mjs; the generated
# output in data/suburbs/ is what the site builds from and IS committed.
/.abs-cache/
/.next-verify/

# ...except the local template, which holds no secrets
!.env.local.example
