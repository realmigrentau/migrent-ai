{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "build:test": "sh -c 'set -a; . ./.env.test; set +a; next build --webpack'",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "content:lastmod": "node scripts/content-lastmod.mjs",
    "check:headers": "node scripts/check-security-headers.mjs",
    "perf:budget": "node scripts/perf-budget.mjs",
    "dev:mock": "node scripts/dev-with-mock.mjs",
    "preview:e2e": "node scripts/preview-e2e.mjs"
  },
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "^2.2.0",
    "@sentry/nextjs": "^10.76.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.93.2",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "framer-motion": "^12.43.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.4",
    "lenis": "^1.3.27",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.14.0",
    "next": "^16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^16.6.6",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "playwright": "^1.61.0",
    "playwright-core": "^1.61.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
