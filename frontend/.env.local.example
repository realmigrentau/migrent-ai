# Copy to .env.local for `npm run dev`. Every NEXT_PUBLIC_* value ends up in
# the browser bundle, so nothing secret belongs in this file.

# Supabase > Project Settings > API. The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=https://nsnwwfbidishftlrimer.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The FastAPI backend. Run it locally (see the root README). The Render API
# only adds localhost to its CORS list outside production (backend/main.py),
# so a local frontend pointed at it fails calls with "Failed to fetch".
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# This site's own address. Used for links in emails and admin tools; sign-in
# redirects always use the address in the browser bar instead.
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Optional locally.
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
